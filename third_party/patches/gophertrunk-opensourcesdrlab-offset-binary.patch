+func TestDecodeInt8IQDetectsOffsetBinaryReproduction(t *testing.T) {
+	buf := make([]byte, 4096)
+	for i := range buf {
+		buf[i] = byte(131 + i%3)
+	}
+	got := decodeInt8IQ(buf)
+	for i := 0; i < 16; i++ {
+		if real(got[i]) < -0.1 || real(got[i]) > 0.1 || imag(got[i]) < -0.1 || imag(got[i]) > 0.1 {
+			t.Fatalf("offset-binary sample was not centered: %v", got[i])
+		}
+	}
+}
