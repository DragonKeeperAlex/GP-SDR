diff --git a/internal/sdr/hackrf/hackrf.go b/internal/sdr/hackrf/hackrf.go
index bfb0860..98cca23 100644
--- a/internal/sdr/hackrf/hackrf.go
+++ b/internal/sdr/hackrf/hackrf.go
@@ -709,10 +709,43 @@ func (d *Device) setMode(mode uint16) error {
 func decodeInt8IQ(buf []byte) []complex64 {
 	n := len(buf) / 2
 	out := make([]complex64, n)
+	offsetBinary := detectOffsetBinary(buf)
 	for i := 0; i < n; i++ {
-		iv := float32(int8(buf[2*i])) / 128
-		qv := float32(int8(buf[2*i+1])) / 128
+		iv, qv := float32(int8(buf[2*i]))/128, float32(int8(buf[2*i+1]))/128
+		if offsetBinary {
+			iv = (float32(buf[2*i]) - 127.5) / 128
+			qv = (float32(buf[2*i+1]) - 127.5) / 128
+		}
 		out[i] = complex(iv, qv)
 	}
 	return out
 }
+
+// Some OpenSourceSDRLab HackRF One / PortaPack H2 reproductions expose
+// offset-binary bytes centred near 128 while retaining the standard HackRF
+// USB identifiers. Interpreting that stream as signed CS8 pins both axes near
+// -1 and triggers a false ADC-overload condition. Genuine signed streams are
+// left untouched.
+func detectOffsetBinary(buf []byte) bool {
+	limit := len(buf)
+	if limit > 32768 {
+		limit = 32768
+	}
+	if limit < 512 {
+		return false
+	}
+	var signedSum, offsetSum float64
+	for _, raw := range buf[:limit] {
+		signedSum += float64(int8(raw))
+		offsetSum += float64(raw) - 127.5
+	}
+	signedMean := signedSum / float64(limit)
+	if signedMean < 0 {
+		signedMean = -signedMean
+	}
+	offsetMean := offsetSum / float64(limit)
+	if offsetMean < 0 {
+		offsetMean = -offsetMean
+	}
+	return signedMean > 80 && offsetMean < 40
+}
