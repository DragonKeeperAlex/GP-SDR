[Unit]
Description=GP-SDR 10-inch touchscreen kiosk
After=gp-sdr.service systemd-user-sessions.service
Wants=gp-sdr.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=sdr
Group=sdr
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
EnvironmentFile=/etc/gp-sdr/web-token.env
Environment=XDG_RUNTIME_DIR=/run/user/1000 HOME=/home/sdr
SupplementaryGroups=video render input
ExecStart=/usr/bin/cage -D -s -- /usr/local/bin/gp-sdr-kiosk
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
